# Required when NEXUS_BIND is not loopback. On loopback, a temporary token is
# generated and printed at startup when this value is empty.
NEXUS_ADMIN_TOKEN=replace-with-at-least-32-random-characters
NEXUS_BIND=127.0.0.1
NEXUS_PORT=8787
NEXUS_DATA_DIR=/data
NEXUS_MAX_BODY_BYTES=1048576
NEXUS_REQUEST_TIMEOUT_MS=5000

# Comma-separated exact hostnames accepted for registered HTTP nodes.
# Loopback hosts are always accepted.
NEXUS_ALLOWED_ENDPOINT_HOSTS=

